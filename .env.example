# Copiá este archivo como .env y completá tus keys (el .env NO se sube a GitHub)

# Pinecone
PINECONE_API_KEY=pcsk_...
INDEX_NAME=colibri
PINECONE_NAMESPACE=colibri-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embeddings (obligatoria) y LLM por defecto
OPENAI_API_KEY=sk-...
EMBEDDINGS_MODEL=text-embedding-3-small

# LLM para main.py: openai | anthropic
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
